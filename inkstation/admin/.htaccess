# Beheerpagina: niet in zoekmachines, config en data nooit los opvraagbaar.
Header set X-Robots-Tag "noindex, nofollow"
<FilesMatch "^(config(\.example)?\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
